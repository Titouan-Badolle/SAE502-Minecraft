# {{ ansible_managed }}
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Exporters déployés avec CT-db et CT-serveur (pull sur infra_mc)
  - job_name: node
    static_configs:
      - targets: ["{{ db_ip }}:9100", "{{ serveur_ip }}:9100"]

  - job_name: mysqld
    static_configs:
      - targets: ["{{ db_ip }}:9104"]
